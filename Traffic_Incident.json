    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    observation,\n    observation_count,\n    observation_count AS total_users,\n    100.00 AS percentage\nFROM\n(\n    SELECT\n        observation,\n        COUNT(*) AS observation_count\n    FROM\n    (\n        SELECT\n            user_id,\n            observation,\n            ROW_NUMBER() OVER (\n                PARTITION BY user_id\n                ORDER BY created_at DESC, id DESC\n            ) AS rn\n        FROM observations\n        WHERE road = '{{ $(\"Webhook2\").item.json.body.road }}'\n          AND recorded_date = '{{ $(\"Webhook2\").item.json.body.recorded_date }}'\n          AND TIME_FORMAT(recorded_time, '%H:%i') =\n              LEFT('{{ $(\"Webhook2\").item.json.body.recorded_time }}', 5)\n          AND classification = 'HAM'\n          AND role <> 'ADMIN'\n    ) AS latest_user_observations\n    WHERE rn = 1\n    GROUP BY observation\n    ORDER BY observation_count DESC, observation ASC\n    LIMIT 1\n) AS majority;",
        "options": {}
      },
